generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String    @default("Active") // Active | Paused | Complete
  approach    String? // Email template / approach notes
  fromEmail   String? // Sending identity for this campaign, e.g. hello@mangood.app.
  // Null falls back to the authenticated mailbox default. See docs/ROADMAP.md task 1.3.
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  accounts    Account[]
}

model Account {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  email         String?
  // Which pipeline this contact belongs to. Selects the status vocabulary in
  // lib/types.ts (STATUS_OPTIONS_BY_KIND) — see docs/ROADMAP.md D15.
  kind          String   @default("customer") // customer | collaborator
  // Status values differ per kind and live in lib/types.ts, not here, because a
  // single schema comment cannot document two vocabularies. Free text either way.
  status        String   @default("Prospect")
  labels        String? // comma-separated
  lastContact   DateTime?
  nextAction    String?
  // The date half of nextAction. Free text alone cannot be queried, which is what
  // /api/queue needs — see docs/ROADMAP.md task 1.2.
  nextActionDue DateTime?
  notes         String?
  draftLink     String? // Gmail draft URL, set once a draft is created
  notesLink     String? // external notes doc link

  // --- Provenance (docs/requirements/01-PRD REQ-08) ---------------------------------
  // Where this contact came from, structured. Previously this lived in `notes` as prose,
  // which the detail form overwrites wholesale on blur — consent evidence in a field that
  // can be destroyed by a stray keystroke is not evidence. Allowed values live in
  // lib/types.ts as SOURCE_TYPES.
  sourceType    String? // waitlist_form | partner_sheet | referral | manual | research
  // The specific instance: which sheet, which form, who referred. Free text.
  sourceDetail  String?
  // When they affirmatively opted in, for the sources where that concept applies. Null is
  // meaningful — it means we have no consent on file, which is exactly what the
  // jurisdiction gate in app/api/gmail/draft/route.ts reads.
  consentedAt   DateTime?

  // --- Jurisdiction (docs/requirements/01-PRD REQ-10) -------------------------------
  // Coarse and hand-set. We record the flag; we deliberately do not encode the statutes
  // (PRD N1). Allowed values live in lib/types.ts as JURISDICTIONS, and the subset that
  // gates a first contact is CONSENT_FIRST_JURISDICTIONS.
  //
  // Deliberately NOT backfilled by script: guessing it from an email domain is false
  // confidence — a .com says nothing, and the company's TLD is not the recipient's
  // location. It is a human pass (REQ-10b).
  jurisdiction  String? // US | EU | UK | CA | JP | OTHER | UNKNOWN

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  statusEvents  StatusEvent[]
  interactions  Interaction[]
}

// Append-only log of Account.status transitions. Account.status is overwritten in
// place and updatedAt is clobbered by any unrelated edit, so without this table
// "how many accounts moved to Engaged this month" is unanswerable for any period
// that has already elapsed. See docs/ROADMAP.md §2.4.
//
// Stores the raw display string, not a slug: statuses are unvalidated free text,
// so a later rename would orphan history keyed on anything else.
model StatusEvent {
  id         String   @id @default(cuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  changedAt  DateTime @default(now())

  @@index([accountId, changedAt])
}

// Append-only record of what was actually said to a contact, written by hand.
//
// Account.notes is one mutable blob: editing it overwrites the previous state, so
// nothing can reconstruct when a thing was said or in which direction. StatusEvent
// answers "when did the stage change" but not "what happened". This table is the
// half of that answer which does not depend on Phase 0 mail infrastructure
// (docs/ROADMAP.md §3) — it works today, with no Gmail scope and no OAuth client.
//
// `threadId` is deliberately present and unused: the contact-scoped Gmail index
// (parked under D14, unparked once sending is verified end-to-end) lands as rows in
// this table rather than a second timeline, so the UI written now doesn't get
// rewritten then. Headers only — bodies stay in Gmail, per the no-inbox-replication
// constraint.
model Interaction {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Free text like every other vocabulary here; the allowed values live in
  // lib/types.ts as INTERACTION_CHANNELS. Nothing validates it server-side.
  channel   String  @default("note") // email | call | meeting | note
  // Null for notes, which have no direction. outbound | inbound otherwise.
  direction String?

  // When it happened, which is not when it was typed — backfilling last week's call
  // is the normal case, so this is settable and createdAt is not.
  occurredAt DateTime @default(now())
  summary    String
  // Set only for entries derived from a real Gmail thread. Null for everything
  // written by hand.
  threadId   String?
  createdAt  DateTime @default(now())

  @@index([accountId, occurredAt])
}

// The signed-in Google identity's tokens, persisted server-side.
//
// Auth.js keeps owning sign-in, the session cookie, and CSRF; this exists for the one
// thing a JWT cookie structurally cannot do — hand a refresh token to code running
// outside a browser request, which is what reply polling needs. It is deliberately NOT
// the Auth.js Prisma adapter: that would require models named User/Session/Account, and
// this schema's `Account` is a CRM contact. See docs/ROADMAP.md D18 — the
// Account→Contact rename is triggered by adopting the adapter, which this avoids.
//
// Single row per Google address; single-tenant by design (D18), so in practice one row.
//
// SECURITY: refreshToken grants ongoing Gmail access until revoked at
// myaccount.google.com/permissions. prisma/dev.db is gitignored and unencrypted on
// disk. That is fine on localhost and is not fine hosted — the same line proxy.ts draws.
model GoogleCredential {
  id           String   @id @default(cuid())
  email        String   @unique
  accessToken  String
  // Null when Google declined to reissue one. `prompt=consent` in lib/auth.ts is what
  // makes that unlikely, since Google only returns a refresh token on first consent.
  refreshToken String?
  expiresAt    DateTime
  // The scopes of the grant that produced this token, which are the scopes of the
  // ORIGINAL consent — a refresh never widens them. Recorded so a route can tell
  // "never granted" from "Gmail is down" instead of surfacing both as a 502.
  scope        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Do-not-contact, keyed on the person rather than on a campaign row
// (docs/requirements/01-PRD REQ-01).
//
// Not a status value, deliberately: `status` is unvalidated free text that the detail
// form overwrites in place (docs/ROADMAP.md E7), so a suppression expressed as a status
// is one careless edit away from being undone, and the queue would happily surface the
// row again. A timestamp cannot be set by accident and reads the same to a lawyer as it
// does to a query.
//
// And not a column on Account, also deliberately. Account is scoped to a Project,
// `email` carries no unique constraint, and the same address legitimately belongs to
// several campaigns — a per-row flag would leave the same human in a second project's
// queue. It would also cascade-delete with the Account, which is exactly the record
// docs/requirements/04-COMPLIANCE-REGISTER §6.3 says must SURVIVE an erasure request:
// erase everything else, keep the address and the timestamp, so the next import cannot
// re-add them.
//
// The address is the primary key because it is the only identifier we hold that means
// the same thing across campaigns. Always normalized through normalizeEmail() in
// lib/contacts.ts before it reaches here — a suppression stored in mixed case is a
// suppression that does not match.
//
// There is deliberately no relation to Account: a relation needs a foreign key, and the
// whole point is that this outlives the row. Joining is done in application code.
model Suppression {
  email      String   @id
  optedOutAt DateTime @default(now())
  // How the opt-out reached us. Allowed values live in lib/types.ts as OPT_OUT_SOURCES.
  source     String? // reply | verbal | form | manual
  // What they actually said, verbatim where possible. This is the evidence.
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
