# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — these hold your Google OAuth client secret and AUTH_SECRET.
# .env.example is committed as the template; real values never are.
.env
.env*.local
.env.production
!.env.example

# database — local SQLite data (your actual CRM contents) stays out of git
*.db
*.db-journal
*.sqlite
*.sqlite3
/prisma/*.db
/prisma/*.db-journal

# vercel
.vercel

# typescript
*.tsbuildinfo

# editors
.idea/
.vscode/*
!.vscode/extensions.json

/node-modules

# Real contact data — this repo is public. The loader
# (prisma/import-mangood.ts) is shareable; the people in it are not.
/prisma/contacts.local.json
/docs/*.csv
