# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — these hold the Google OAuth client secret, AUTH_SECRET, and the sender
# identity (a real legal name and a real postal address, i.e. personal data).
# .env.example is committed as the template; real values never are.
#
# `.env*` and not `.env` plus a list: the enumerated form covered .env, .env*.local and
# .env.production but NOT an ad-hoc copy like `.env.bak.1699` or `.env.old`, which is
# exactly the shape a backup taken before an edit has. One glob, one exception.
.env*
!.env.example

# database — local SQLite data (your actual CRM contents) stays out of git
*.db
*.db-journal
*.sqlite
*.sqlite3
/prisma/*.db
/prisma/*.db-journal

# vercel
.vercel

# typescript
*.tsbuildinfo

# editors
.idea/
.vscode/*
!.vscode/extensions.json

/node-modules

# Real contact data — this repo is public. The loader
# (prisma/import-mangood.ts) is shareable; the people in it are not.
/prisma/contacts.local.json
/docs/*.csv

# dev feedback capture (components/dev/dev-feedback.tsx) — local notes and
# element screenshots from a testing session, not project history
/.claude/dev-feedback.json
/.claude/dev-feedback/
