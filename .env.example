# Copy to .env and fill in. Never commit .env — it holds real secrets.

# SQLite for local use. Swap for a Postgres URL when you host this online
# (also change `provider` in prisma/schema.prisma to "postgresql").
DATABASE_URL="file:./dev.db"

# Generate with: npx auth secret
AUTH_SECRET=""

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OpenRouter — powers POST /api/compose (LLM email drafting). Optional: without it the
# route returns 501 and the composer still works by hand.
# Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# Optional. Any OpenRouter model slug. Defaults to google/gemini-3-flash-preview.
OPENROUTER_MODEL=""

# Required before any outreach email can be drafted. Both appear in the footer of every
# message the app builds — the legal entity that is sending, and a real postal address —
# because CAN-SPAM, CASL and the ePrivacy Directive each require them. Drafting fails
# closed with a message naming the missing variable if either is blank, which is
# deliberate: a footer with a gap in it looks compliant and isn't.
#
# One value each, not one per campaign. The footer names the legal ENTITY, which sits
# above a campaign — see docs/requirements/02-TRD-technical-spec.md §6.1.
CRM_SENDER_LEGAL_NAME=""
CRM_SENDER_POSTAL_ADDRESS=""
